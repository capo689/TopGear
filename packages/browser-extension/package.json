{
  "name": "@browser-bridge/browser-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The extension-relay BrowserBackend: drives the signed-in profile via the daemon socket → shim → SW → content script.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@browser-bridge/backend": "workspace:*",
    "@browser-bridge/protocol": "workspace:*",
    "@browser-bridge/semantic-engine": "workspace:*",
    "@browser-bridge/relay": "workspace:*"
  },
  "devDependencies": {
    "@browser-bridge/browser-playwright": "workspace:*",
    "@browser-bridge/fixture-farm": "workspace:*"
  }
}
