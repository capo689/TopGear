{
  "name": "@browser-bridge/pattern-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Harvest loops through the scheduler; crawl policy (robots, budgets, auth-wall). Capture ≠ comprehension.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
