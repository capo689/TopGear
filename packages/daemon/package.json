{
  "name": "@browser-bridge/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Session registry + gateway: binds TaskGrants, capability handshake, drives execution over a backend.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@browser-bridge/protocol": "workspace:*",
    "@browser-bridge/policy": "workspace:*",
    "@browser-bridge/audit": "workspace:*",
    "@browser-bridge/secrets": "workspace:*",
    "@browser-bridge/execution": "workspace:*",
    "@browser-bridge/backend": "workspace:*"
  },
  "devDependencies": {
    "@browser-bridge/browser-playwright": "workspace:*",
    "@browser-bridge/fixture-farm": "workspace:*"
  }
}
