{
  "name": "browser-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A model-agnostic runtime that lets any AI operate a browser at machine speed.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
